<div class="mb-3">
    <label class="form-label" for="customer_family_code_select">{{ 'Customer family'|trans({}, 'customerfamily') }}</label>
    <select name="{{ form_name }}[{{ field_name }}]" id="customer_family_code_select" class="form-control">
        <option value="" data-code="none" selected>-- {{ 'Select customer family'|trans }} --</option>
        {% for family in families %}
            <option value="{{ family.code }}" data-code="{{ family.code }}">{{ family.title }}</option>
        {% endfor %}
    </select>
</div>
