<div class="mb-3">
    <label for="purchase_price" class="form-label">{{ 'Purchase price (w/o taxes)'|trans({}, 'customerfamily.bo.default') }} :</label>
    <div class="input-group">
        <input type="text" name="purchase_price" class="form-control" value="{{ purchasePrice }}" placeholder="{{ 'Purchase price (w/o taxes)'|trans({}, 'customerfamily.bo.default') }}">
        <span class="input-group-text">{{ currencySymbol }}</span>
    </div>
</div>

{% for price in calculatedPrices %}
    <div class="mb-3">
        <label class="form-label">
            {{ 'Calculated prices for:'|trans({}, 'customerfamily.bo.default') }}
            <a href="{{ path('customer_family_view') }}">{{ price.CUSTOMER_FAMILY_TITLE }}</a>
        </label>
        <div class="row mb-2">
            <label class="col-md-3 col-form-label">{{ 'Untaxed'|trans({}, 'customerfamily.bo.default') }}</label>
            <div class="col-md-8 input-group">
                <input type="text" class="form-control" value="{{ price.CALCULATED_PRICE }}" disabled>
                <span class="input-group-text">{{ currencySymbol }}</span>
            </div>
        </div>
        <div class="row">
            <label class="col-md-3 col-form-label">{{ 'Taxed'|trans({}, 'customerfamily.bo.default') }}</label>
            <div class="col-md-8 input-group">
                <input type="text" class="form-control" value="{{ price.CALCULATED_TAXED_PRICE }}" disabled>
                <span class="input-group-text">{{ currencySymbol }}</span>
            </div>
        </div>
    </div>
{% endfor %}
