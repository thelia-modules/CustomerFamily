{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Customer Family'|trans({}, 'customerfamily.bo.default') }}{% endblock %}

{% block content %}
{% set admin_current_location = 'module' %}

{% if not is_granted('VIEW', {resource: 'admin.module', module: 'CustomerFamily'}) %}
    {{ 'Sorry, you are not allowed to perform this action.'|trans }}
{% else %}
<div class="card" id="CustomerFamily">
    <div class="card-header">
        <h1 class="h3 mb-0">{{ 'Customer Family'|trans({}, 'customerfamily.bo.default') }}</h1>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs" id="tabbed-menu" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#families" type="button">{{ 'Families'|trans({}, 'customerfamily.bo.default') }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prices_definition" type="button">{{ 'Prices definition'|trans({}, 'customerfamily.bo.default') }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#category_restrictions" type="button">{{ 'Category restrictions'|trans({}, 'customerfamily.bo.default') }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#brand_restrictions" type="button">{{ 'Brand restrictions'|trans({}, 'customerfamily.bo.default') }}</button></li>
        </ul>

        <div class="tab-content pt-3"
             data-controller="cf-config"
             data-cf-config-delete-url-value="{{ path('customer_family_delete', {id: 'CFID'}) }}"
             data-cf-config-update-url-value="{{ path('customer_family_update', {id: 'CFID'}) }}"
             data-cf-config-default-url-value="{{ path('customer_family_update-default') }}"
             data-cf-config-redirect-url-value="{{ path('customer_family_view') }}">

            {# ---------------- Families tab ---------------- #}
            <div id="families" class="tab-pane fade show active">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <ul class="nav nav-pills">
                            {% for lang in langs %}
                                <li class="nav-item">
                                    <a class="nav-link {{ lang.id == edit_language_id ? 'active' : '' }}"
                                       href="{{ path('customer_family_view', {edit_language_id: lang.id}) }}"
                                       title="{{ 'Edit information in %lng'|trans({'%lng': lang.title}) }}">{{ lang.code|upper }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="col-md-12">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'ID'|trans }}</th>
                                    <th>{{ 'Code'|trans }}</th>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th>{{ 'Default'|trans }}</th>
                                    <th>{{ 'Action'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if families is not empty %}
                                    <form action="{{ path('customer_family_update-default') }}" method="post" id="update-default-family-form" data-cf-config-target="defaultForm">
                                        <input type="hidden" name="customer_family_id" id="default_family_id">
                                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                                    </form>
                                    {% for family in families %}
                                        <tr>
                                            <td>{{ family.id }}</td>
                                            <td>{{ family.code }}</td>
                                            <td>{{ family.title }}</td>
                                            <td>
                                                <input type="radio" name="is_default" class="update-default-family form-check-input" data-id="{{ family.id }}" data-action="cf-config#setDefault" {{ family.is_default ? 'checked' : '' }}>
                                            </td>
                                            <td>
                                                <a class="btn btn-info btn-sm js-action-update" data-id="{{ family.id }}" data-code="{{ family.code }}" data-title="{{ family.title }}" data-action="cf-config#openUpdate">{{ 'Edit'|trans({}, 'customerfamily.bo.default') }}</a>
                                                <a class="btn btn-danger btn-sm js-action-delete" data-id="{{ family.id }}" data-action="cf-config#openDelete">{{ 'Delete'|trans }}</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr><td colspan="5" class="text-center">{{ 'No family'|trans({}, 'customerfamily.bo.default') }}</td></tr>
                                {% endif %}
                            </tbody>
                            <tfoot class="text-center">
                                <tr>
                                    <td colspan="5">
                                        <form action="{{ path('customer_family_create') }}" method="POST" class="row row-cols-lg-auto g-2 align-items-center justify-content-center">
                                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                                            <input type="hidden" name="locale" value="{{ edit_language_locale }}">
                                            <div class="col">
                                                <input class="form-control" type="text" required placeholder="{{ 'Code'|trans({}, 'customerfamily') }}" name="code">
                                            </div>
                                            <div class="col">
                                                <input class="form-control" type="text" required placeholder="{{ 'Title'|trans }}" name="title">
                                            </div>
                                            <div class="col">
                                                <button type="submit" class="btn btn-primary">{{ 'Add'|trans }}</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                {# Delete modal #}
                <div class="modal js-modal-delete" tabindex="-1" data-cf-config-target="deleteModal" aria-hidden="true">
                    <div class="modal-dialog">
                        <form action="" method="POST" data-cf-config-target="deleteFormEl">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <div class="modal-content">
                                <div class="modal-body">{{ 'Do you really want to delete this customer family ?'|trans({}, 'customerfamily.bo.default') }}</div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'No'|trans }}</button>
                                    <button type="submit" class="btn btn-danger">{{ 'Yes'|trans }}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                {# Update modal #}
                <div class="modal js-modal-update" tabindex="-1" data-cf-config-target="updateModal" aria-hidden="true">
                    <div class="modal-dialog">
                        <form action="" method="POST" data-cf-config-target="updateFormEl">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <input type="hidden" name="locale" value="{{ edit_language_locale }}">
                            <div class="modal-content">
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label">{{ 'Code'|trans({}, 'customerfamily') }}</label>
                                        <input class="form-control js-field-code" type="text" required name="code" data-cf-config-target="updateCode">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">{{ 'Title'|trans }}</label>
                                        <input class="form-control js-field-title" type="text" required name="title" data-cf-config-target="updateTitle">
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                                    <button type="submit" class="btn btn-primary">{{ 'Update'|trans }}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="mt-3">
                    <form action="{{ path('customer_family_update_price') }}" method="post">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="price_mode" id="customer_family_price_mode_price_mode" value="1" {{ price_mode ? 'checked' : '' }} onchange="this.form.submit()">
                            <label class="form-check-label" for="customer_family_price_mode_price_mode">{{ 'Use the product price'|trans({}, 'customerfamily') }}</label>
                        </div>
                        <div class="form-text">{{ 'By checking this check box this module will use the product price of Thelia instead of the the purchase price of CustomerFamily'|trans({}, 'customerfamily') }}</div>
                    </form>
                </div>
            </div>

            {# ---------------- Prices definition tab ---------------- #}
            <div id="prices_definition" class="tab-pane fade">
                <br>
                <h4 class="text-center">{{ "Define if your prices are the products' ones or if they are calculated by the equation with your parameters."|trans({}, 'customerfamily.bo.default') }}</h4>
                <h4 class="text-center">{{ 'Not using the equation will display the fix product price to customers.'|trans({}, 'customerfamily.bo.default') }}</h4>
                <h3 class="text-center">{{ 'Equation: ( ( product_purchase_price + fix_amount_1 ) x factor ) + fix_amount_2'|trans({}, 'customerfamily.bo.default') }}</h3>
                <br>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>{{ 'Customer family'|trans({}, 'customerfamily.bo.default') }}</th>
                            <th>{{ 'Use equation'|trans({}, 'customerfamily.bo.default') }}</th>
                            <th>{{ 'Fix amount 1'|trans({}, 'customerfamily.bo.default') }}</th>
                            <th>{{ 'Factor'|trans({}, 'customerfamily.bo.default') }}</th>
                            <th>{{ 'Fix amount 2'|trans({}, 'customerfamily.bo.default') }}</th>
                            <th>{{ 'Show taxes'|trans({}, 'customerfamily.bo.default') }}</th>
                            <th>{{ 'Save'|trans({}, 'customerfamily.bo.default') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in priceRows %}
                            <tr>
                                <td>
                                    <form action="{{ path('customer_family_update_price_calculation') }}" method="post" class="row g-2 align-items-center">
                                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                                        <input type="hidden" name="promo" value="{{ row.promo }}">
                                        <input type="hidden" name="customer_family_id" value="{{ row.customer_family_id }}">
                                        <div class="col-auto">{{ row.title }}{% if row.promo %} - {{ 'Promo'|trans({}, 'customerfamily.bo.default') }}{% endif %}</div>
                                </td>
                                <td><input type="checkbox" class="form-check-input" name="use_equation" {{ row.use_equation ? 'checked' : '' }}></td>
                                <td><input type="number" class="form-control" name="amount_added_before" step="any" value="{{ row.amount_added_before }}"></td>
                                <td><input type="number" class="form-control" name="coefficient" step="any" value="{{ row.coefficient }}"></td>
                                <td><input type="number" class="form-control" name="amount_added_after" step="any" value="{{ row.amount_added_after }}"></td>
                                <td><input type="checkbox" class="form-check-input" name="is_taxed" {{ row.is_taxed ? 'checked' : '' }}></td>
                                <td><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i></button></form></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ---------------- Category restrictions tab ---------------- #}
            <div id="category_restrictions" class="tab-pane fade">
                {% for family in families %}
                    <div class="card mb-3">
                        <div class="card-body">
                            <form method="post" action="{{ path('customer_family_category_restriction', {customerFamilyId: family.id}) }}">
                                <h5 class="card-title">{{ family.title }}</h5>
                                <div class="form-check mb-2">
                                    <input name="restriction_enabled" class="form-check-input restriction_toggler" id="category_restriction_{{ family.id }}" type="checkbox" data-action="cf-config#toggleRestriction" data-target-id="toggled_by_category_restriction_{{ family.id }}" {{ family.category_restriction_enabled ? 'checked' : '' }}>
                                    <label class="form-check-label" for="category_restriction_{{ family.id }}">{{ 'Enable category restriction for this customer family'|trans({}, 'customerfamily.bo.default') }}</label>
                                </div>
                                <div class="restriction_toggled toggled_by_category_restriction_{{ family.id }}" {{ family.category_restriction_enabled ? '' : 'style=display:none' }}>
                                    <p>{{ 'Choose what categories will be available for this customer family'|trans({}, 'customerfamily.bo.default') }}</p>
                                    <select class="form-control" name="available_categories[]" multiple>
                                        {% for cat in categoryRestrictions[family.id]|default([]) %}
                                            <option value="{{ cat.id }}" {{ cat.available ? 'selected' : '' }}>{{ cat.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-success w-100 mt-2">{{ 'Save'|trans }}</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# ---------------- Brand restrictions tab ---------------- #}
            <div id="brand_restrictions" class="tab-pane fade">
                {% for family in families %}
                    <div class="card mb-3">
                        <div class="card-body">
                            <form method="post" action="{{ path('customer_family_brand_restriction', {customerFamilyId: family.id}) }}">
                                <h5 class="card-title">{{ family.title }}</h5>
                                <div class="form-check mb-2">
                                    <input name="restriction_enabled" class="form-check-input restriction_toggler" id="brand_restriction_{{ family.id }}" type="checkbox" data-action="cf-config#toggleRestriction" data-target-id="toggled_by_brand_restriction_{{ family.id }}" {{ family.brand_restriction_enabled ? 'checked' : '' }}>
                                    <label class="form-check-label" for="brand_restriction_{{ family.id }}">{{ 'Enable brand restriction for this customer family'|trans({}, 'customerfamily.bo.default') }}</label>
                                </div>
                                <div class="restriction_toggled toggled_by_brand_restriction_{{ family.id }}" {{ family.brand_restriction_enabled ? '' : 'style=display:none' }}>
                                    <p>{{ 'Choose what brands will be available for this customer family'|trans({}, 'customerfamily.bo.default') }}</p>
                                    <select class="form-control" name="available_categories[]" multiple>
                                        {% for brand in brandRestrictions[family.id]|default([]) %}
                                            <option value="{{ brand.id }}" {{ brand.available ? 'selected' : '' }}>{{ brand.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-success w-100 mt-2">{{ 'Save'|trans }}</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="update-default-family-failed" tabindex="-1" aria-hidden="true" data-cf-config-target="failedModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">{{ 'An error occured'|trans({}, 'customerfamily.bo.default') }}</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="update-default-family-failed-body" data-cf-config-target="failedBody"></div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
